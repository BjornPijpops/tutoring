# Public build-time values only. Copy to .env.local (gitignored) for local development.
# Never put service-role keys, Resend keys or any other secret here: everything
# prefixed VITE_ ends up in the browser bundle.

# Supabase project URL and anon (public) key. Optional until the Supabase adapter lands.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path the site is served from (default: /tutoring/ for GitHub Pages).
# VITE_BASE_PATH=/tutoring/
